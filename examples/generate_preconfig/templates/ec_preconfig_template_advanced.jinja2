        {% if data[prefix ~ 'segment'] is defined and data[prefix ~ 'segment'] != "" %}
      segment: {{ data[prefix ~ 'segment'] }}
        {% endif %}
        {% if data[prefix ~ 'zone'] is defined and data[prefix ~ 'zone'] != "" %}
      zone: {{ data[prefix ~ 'zone'] }}
        {% endif %}
      {% endif %}
    {% endfor %}
